# Your One API key. After `one init`, find it in ~/.one/config.json (apiKey)
# or in the dashboard at https://app.withone.ai
ONE_SECRET=

# Your Anthropic API key (https://platform.claude.com)
ANTHROPIC_API_KEY=

# Connection keys from `one --agent connection list` (the `key` field)
ONE_CONNECTION_HUBSPOT=
ONE_CONNECTION_GMAIL=

# Optional: post the run as one Slack message (both must be set)
# ONE_CONNECTION_SLACK=
# SLACK_CHANNEL=C0123456789

# Optional: how far back to look for new leads, in hours (default 24)
# LOOKBACK_HOURS=24

# Optional: minutes after which an unanswered lead counts as late (default 15)
# SLA_MINUTES=15

# Optional: seconds between polls in --watch mode (default 120)
# WATCH_SECONDS=120

# Optional: override the Claude model (default claude-opus-5-5)
# CLAUDE_MODEL=claude-opus-5-5
